# Shared settings
JWT_SECRET=change-this-jwt-secret-with-at-least-32-characters
JWT_EXPIRATION_MINUTES=120
DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
DB_USERNAME=rm559728
DB_PASSWORD=your-oracle-password-here
DB_DRIVER_CLASS_NAME=oracle.jdbc.OracleDriver
DB_DIALECT=org.hibernate.dialect.OracleDialect
FLYWAY_LOCATIONS=classpath:db/migration
DB_POOL_SIZE=2
DB_MIN_IDLE=0
DB_IDLE_TIMEOUT=10000
DB_MAX_LIFETIME=120000
DB_CONNECTION_TIMEOUT=30000
FLYWAY_ENABLED=true

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

# Optional local Oracle container
# Use only if you want to run the database locally with:
# docker compose --profile local-db up -d --build
ORACLE_PASSWORD=Oracle123!
ORACLE_APP_PASSWORD=Signal123!
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_PORT=1521

